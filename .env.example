# Full base address of the ASP.NET API, including its /api-v1 prefix. Every request
# (browser and Next.js server) is this + the endpoint, e.g. /Auth/SendOtp.
# The JWT goes in the Authorization header; Next.js has no backend of its own.
NEXT_PUBLIC_PAPER_API_URL=https://www.kaghaz20.ir/api-v1
# Optional server-only fallback; leave equal to the line above.
PAPER_API_URL=https://www.kaghaz20.ir/api-v1

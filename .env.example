# ASP.NET backend address (without /api-v1). Next.js has no backend of its own:
# NEXT_PUBLIC_API_URL is what the browser calls (login, cart, payment, admin panel;
# the JWT goes in the Authorization header), PAPER_API_URL is what the Next.js server
# uses to render product pages, the sitemap and the account panel. Usually the same.
NEXT_PUBLIC_API_URL=https://api.example.ir
PAPER_API_URL=https://api.example.ir
